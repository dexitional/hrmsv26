# The existing HR database (legacy "hr" schema, upgraded by packages/db/migrations).
DATABASE_URL="mysql://root:your_password_here@localhost:3306/hr26"
# At least 32 random characters. Signs sign-in sessions: openssl rand -hex 32
SESSION_SECRET=
# The public address. Circular PDF links sent to staff are built from it.
APP_URL=http://localhost:3030
# Where files uploaded through the old HRMS (/public/...) are served.
LEGACY_HRMS_URL=https://hrms.ucc.edu.gh
# Where documents uploaded through the old staff portal are served.
LEGACY_PORTAL_URL=https://staffportal.ucc.edu.gh
# Defaults to apps/web/storage. Use an absolute path outside the release in production.
STORAGE_DIR=
# Google sign-in. Register {APP_URL}/api/auth/google/callback as an authorised
# redirect URI. Only emails that already have an HRMS account can sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development only: shows an "email-only" sign-in for testing Google accounts.
DEV_LOGIN=false

# --- Notifications -----------------------------------------------------------
# SMS: mNotify first, SMSOnlineGH as backup. The sender ID (max 11 characters)
# must be registered with both gateways.
MNOTIFY_API_KEY=
SMSONLINEGH_API_KEY=
SMS_SENDER_ID=UCC-DHR
# Email through Google (Gmail) with an App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME="UCC Directorate of Human Resource"
# Run the scheduled jobs (daily 07:00 GMT; national service on 1 November).
SCHEDULER_ENABLED=true
# Development only: with no gateway keys, log messages as "simulated" instead of sending.
MESSAGING_SIMULATE=false
